# AgentKernel local/production secret template.
# Copy to .env.smoke for local dev/smoke runs, or configure the same keys in CI/server secrets.
# Comment lines may contain spaces. Non-comment key/value lines must not contain spaces.

CLOUDAIKEY_API_KEY=
CLOUDAIKEY_BASE_URL=https://api.cloudaikey.com/v1

# Local SQLite database for the web workspace/session sidebar.
DATABASE_URL=file:../data/agent-kernel-dev.db

# Company image model examples.
# Example models: image-01, image-01-live
IMAGE_MINIMAX_BASE_URL=https://api.minimaxi.com
IMAGE_GROK_API_KEY=
IMAGE_GROK_BASE_URL=
